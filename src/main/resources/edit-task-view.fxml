<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.taskmanager.ui.EditTaskController">

    <VBox spacing="10" style="-fx-padding: 20;">

        <Label style="-fx-font-size: 18;" text="Edit Task" />

        <Label text="Task Type" />
        <Label fx:id="taskTypeLabel" />

        <Label text="Title" />
        <TextField fx:id="titleField" promptText="Enter title..." />

        <Label text="Description (optional)" />
        <TextArea fx:id="descriptionField" prefHeight="80" promptText="Enter description..." />

        <HBox spacing="12">
            <VBox spacing="5">
                <Label text="Deadline" />
                <DatePicker fx:id="deadlinePicker" />
            </VBox>
            <VBox spacing="5">
                <Label text="Estimated hours" />
                <TextField fx:id="estimatedHoursField" promptText="Hours..." />
            </VBox>
        </HBox>

        <VBox fx:id="courseBox" spacing="5">
            <Label text="Course"/>
            <ComboBox fx:id="courseComboBox" prefWidth="300"/>
        </VBox>

        <VBox fx:id="referenceChapterBox" spacing="5">
            <Label text="Reference chapter"/>
            <TextField fx:id="referenceChapterField" promptText="e.g. Chapter 3"/>
        </VBox>

        <VBox fx:id="examDateBox" spacing="5">
            <Label text="Exam date"/>
            <DatePicker fx:id="examDatePicker"/>
        </VBox>

        <VBox fx:id="locationBox" spacing="5">
            <Label text="Location"/>
            <TextField fx:id="locationField" promptText="e.g. Secretary's office"/>
        </VBox>

        <VBox fx:id="contactPersonBox" spacing="5">
            <Label text="Contact person"/>
            <TextField fx:id="contactPersonField" promptText="e.g. Prof. Papadopoulos"/>
        </VBox>

        <VBox fx:id="appointmentTimeBox" spacing="5">
            <Label text="Appointment time"/>
            <HBox spacing="10">
                <ComboBox fx:id="hourComboBox" promptText="Hour" prefWidth="130"/>
                <ComboBox fx:id="minuteComboBox" promptText="Minutes" prefWidth="130"/>
            </HBox>
        </VBox>

        <VBox fx:id="documentNameBox" spacing="5">
            <Label text="Document name"/>
            <TextField fx:id="documentNameField" promptText="e.g. Certificate of studies"/>
        </VBox>

        <Label text="Status" />
        <ComboBox fx:id="statusComboBox" prefWidth="300" />

        <Label style="-fx-text-fill: gray; -fx-font-size: 11;" text="— Reminder and priority —" />

        <HBox spacing="12">
            <VBox spacing="5">
                <Label text="Reminder" />
                <ComboBox fx:id="reminderTypeComboBox" prefWidth="160" />
            </VBox>
            <VBox spacing="5">
                <Label text="Priority" />
                <HBox spacing="8">
                    <Button fx:id="lowPriorityBtn" onAction="#handleLowPriority" text="Low" />
                    <Button fx:id="mediumPriorityBtn" onAction="#handleMediumPriority" text="Medium" />
                    <Button fx:id="highPriorityBtn" onAction="#handleHighPriority" text="High" />
                </HBox>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="cancelBtn" onAction="#handleCancelBtn" text="Cancel" />
            <Button fx:id="saveBtn" onAction="#handleSaveBtn" text="Save" />
        </HBox>

    </VBox>

</ScrollPane>
