<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.taskmanager.ui.TaskDetailController">

    <VBox spacing="10" style="-fx-padding: 20;">

        <Label fx:id="titleLabel" style="-fx-font-size: 18;" />

        <Label style="-fx-text-fill: gray; -fx-font-size: 11;" text="— General info —" />

        <HBox spacing="10">
            <Label text="Type:" />
            <Label fx:id="typeLabel" />
        </HBox>
        <HBox spacing="10">
            <Label text="Description:" />
            <Label fx:id="descriptionLabel" />
        </HBox>
        <HBox spacing="10">
            <Label text="Deadline:" />
            <Label fx:id="deadlineLabel" />
        </HBox>
        <HBox spacing="10">
            <Label text="Estimated hours:" />
            <Label fx:id="estimatedHoursLabel" />
        </HBox>
        <HBox spacing="10">
            <Label text="Priority:" />
            <Label fx:id="priorityLabel" />
        </HBox>
        <HBox spacing="10">
            <Label text="Status:" />
            <Label fx:id="statusLabel" />
        </HBox>
        <HBox spacing="10">
            <Label text="Reminder:" />
            <Label fx:id="reminderLabel" />
        </HBox>

        <HBox fx:id="courseBox" spacing="10">
            <Label text="Course:" />
            <Label fx:id="courseLabel" />
        </HBox>
        <HBox fx:id="referenceChapterBox" spacing="10">
            <Label text="Reference chapter:" />
            <Label fx:id="referenceChapterLabel" />
        </HBox>
        <HBox fx:id="examDateBox" spacing="10">
            <Label text="Exam date:" />
            <Label fx:id="examDateLabel" />
        </HBox>

        <HBox fx:id="locationBox" spacing="10">
            <Label text="Location:" />
            <Label fx:id="locationLabel" />
        </HBox>
        <HBox fx:id="contactPersonBox" spacing="10">
            <Label text="Contact person:" />
            <Label fx:id="contactPersonLabel" />
        </HBox>
        <HBox fx:id="appointmentTimeBox" spacing="10">
            <Label text="Appointment time:" />
            <Label fx:id="appointmentTimeLabel" />
        </HBox>
        <HBox fx:id="documentNameBox" spacing="10">
            <Label text="Document name:" />
            <Label fx:id="documentNameLabel" />
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button onAction="#handleClose" text="Close" />
        </HBox>

    </VBox>

</ScrollPane>
