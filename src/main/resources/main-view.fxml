<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.taskmanager.ui.MainController">
   <children>
      <BorderPane prefHeight="600.0" prefWidth="900.0">
         <left>
            <VBox prefWidth="180.0" spacing="5.0" BorderPane.alignment="CENTER">
               <children>
                  <Label prefWidth="160.0" text="Views">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets left="5.0" top="8.0" />
                     </padding>
                  </Label>
                  <Button mnemonicParsing="false" onAction="#handleAllTasks" prefHeight="35.0" prefWidth="160.0" text="📋 All tasks">
                     <padding>
                        <Insets left="5.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" />
                     </VBox.margin>
                  </Button>
                  <Button minWidth="112.0" mnemonicParsing="false" onAction="#handlePending" prefHeight="35.0" prefWidth="160.0" text="⏳ Pending">
                     <padding>
                        <Insets left="5.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" />
                     </VBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#handleExpiringSoon" prefHeight="35.0" prefWidth="160.0" text="⚠️ Expiring soon">
                     <padding>
                        <Insets left="5.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" />
                     </VBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#handleCompleted" prefHeight="35.0" prefWidth="160.0" text="✅ Completed">
                     <padding>
                        <Insets left="5.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" />
                     </VBox.margin>
                  </Button>
                  <Label text="Categories">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets left="5.0" top="8.0" />
                     </padding>
                  </Label>
                  <Button mnemonicParsing="false" onAction="#handleCourseTasks" prefHeight="35.0" prefWidth="160.0" text="📚 Course tasks">
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" />
                     </VBox.margin>
                     <padding>
                        <Insets left="5.0" />
                     </padding>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#handlePersonalTasks" prefHeight="35.0" prefWidth="160.0" text="👤 Personal tasks">
                     <padding>
                        <Insets left="5.0" />
                     </padding>
                     <VBox.margin>
                        <Insets left="5.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <VBox alignment="CENTER" prefHeight="70.0" prefWidth="120.0" spacing="5.0">
                           <children>
                              <Label text="Total">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                              <Label fx:id="totalLabel" text="12">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                           </children>
                           <padding>
                              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                           </padding>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="70.0" prefWidth="120.0" spacing="5.0">
                           <children>
                              <Label text="Pending">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                              <Label fx:id="pendingLabel" text="7">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                           </children>
                           <padding>
                              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                           </padding>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="70.0" prefWidth="120.0" spacing="5.0">
                           <children>
                              <Label text="Expiring soon">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                              <Label fx:id="expiringSoonLabel" text="3">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                           </children>
                           <padding>
                              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                           </padding>
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="70.0" prefWidth="120.0" spacing="5.0">
                           <children>
                              <Label text="Completed">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                              <Label fx:id="completedLabel" text="5">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                           </children>
                           <padding>
                              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                           </padding>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </HBox>
                  <HBox prefHeight="45.0" spacing="8.0">
                     <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                     </padding>
                     <children>
                        <TextField fx:id="searchField" prefHeight="32.0" prefWidth="200.0" promptText="Search tasks..." HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="categoryFilterComboBox" prefHeight="32.0" prefWidth="130.0" promptText="All categories" />
                        <ComboBox fx:id="sortComboBox" prefHeight="32.0" prefWidth="130.0" promptText="Sort by:Deadline" />
                        <Button mnemonicParsing="false" onAction="#handleManageCourses" prefHeight="32.0" prefWidth="150.0" text=" 📚Manage Courses" />
                        <Button fx:id="newTaskBtn" mnemonicParsing="false" onAction="#handleNewTask" prefHeight="32.0" prefWidth="100.0" text="+ New task" />
                     </children>
                  </HBox>
                  <TableView fx:id="taskTableView" maxHeight="1.7976931348623157E308" prefWidth="200.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="titleColumn" prefWidth="200.0" text="TITLE" />
                      <TableColumn fx:id="categoryColumn" prefWidth="100.0" text="CATEGORY" />
                        <TableColumn fx:id="deadlineColumn" prefWidth="120.0" text="DEADLINE" />
                        <TableColumn fx:id="statusColumn" prefWidth="100.0" text="STATUS" />
                       <TableColumn fx:id="priorityColumn" text="PRIORITY" />
                        <TableColumn fx:id="actionsColumn" prefWidth="90.0" text="ACTIONS" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </center>
      </BorderPane>
   </children>
</VBox>
