<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.taskmanager.ui.AddTaskController">

    <VBox spacing="10" style="-fx-padding: 20;">

        <Label text="Add New Task" style="-fx-font-size: 18;"/>

        <Label text="Task Type"/>
        <ComboBox fx:id="taskTypeComboBox" prefWidth="300"/>

        <Label text="Title"/>
        <TextField fx:id="titleField" promptText="Enter title..."/>

        <Label text="Description (optional)"/>
        <TextArea fx:id="descriptionField" promptText="Enter description..." prefHeight="80"/>

        <HBox spacing="12">
            <VBox spacing="5">
                <Label text="Deadline"/>
                <DatePicker fx:id="deadlinePicker"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Estimated hours"/>
                <TextField fx:id="estimatedHoursField" promptText="Hours..."/>
            </VBox>
        </HBox>

        <VBox fx:id="courseBox" spacing="5">
            <Label text="Course"/>
            <ComboBox fx:id="courseComboBox" prefWidth="300"/>
        </VBox>

        <VBox fx:id="referenceChapterBox" spacing="5">
            <Label text="Reference chapter"/>
            <TextField fx:id="referenceChapterField" promptText="e.g. Chapter 3"/>
        </VBox>

        <VBox fx:id="examDateBox" spacing="5">
            <Label text="Exam date"/>
            <DatePicker fx:id="examDatePicker"/>
        </VBox>

        <VBox fx:id="locationBox" spacing="5">
            <Label text="Location"/>
            <TextField fx:id="locationField" promptText="e.g. Secretary's office"/>
        </VBox>

        <VBox fx:id="contactPersonBox" spacing="5">
            <Label text="Contact person"/>
            <TextField fx:id="contactPersonField" promptText="e.g. Prof. Papadopoulos"/>
        </VBox>

        <VBox fx:id="appointmentTimeBox" spacing="5">
            <Label text="Appointment time"/>
            <HBox spacing="10">
                <ComboBox fx:id="hourComboBox" promptText="Hour" prefWidth="130"/>
                <ComboBox fx:id="minuteComboBox" promptText="Minutes" prefWidth="130"/>
            </HBox>
        </VBox>

        <VBox fx:id="documentNameBox" spacing="5">
            <Label text="Document name"/>
            <TextField fx:id="documentNameField" promptText="e.g. Certificate of studies"/>
        </VBox>

        <Label text="— Reminder and priority —" style="-fx-text-fill: gray; -fx-font-size: 11;"/>

        <HBox spacing="12">
            <VBox spacing="5">
                <Label text="Reminder"/>
                <ComboBox fx:id="reminderComboBox" prefWidth="160"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Priority"/>
                <HBox spacing="8">
                    <Button fx:id="lowPriorityBtn" text="Low" onAction="#handleLowPriority"/>
                    <Button fx:id="mediumPriorityBtn" text="Medium" onAction="#handleMediumPriority"/>
                    <Button fx:id="highPriorityBtn" text="High" onAction="#handleHighPriority"/>
                </HBox>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="cancelBtn" text="Cancel" onAction="#handleCancel"/>
            <Button fx:id="saveBtn" text="Save" onAction="#handleSave"/>
        </HBox>

    </VBox>

</ScrollPane>